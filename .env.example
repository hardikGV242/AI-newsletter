# Copy this file to ".env" (same folder) and fill in the values.
# NEVER upload the real .env to GitHub. It is already listed in .gitignore.

# Free Google Gemini key from https://aistudio.google.com/apikey (see step 3 of README.md)
GEMINI_API_KEY=

# The webhook link of the Teams Workflow for the channel (step 2)
TEAMS_WEBHOOK_URL=

# Optional: a second webhook for failure alerts to you (step 2, part C)
TEAMS_ALERT_WEBHOOK_URL=
